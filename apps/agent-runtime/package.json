{
  "name": "@adlc/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@adlc/executor": "workspace:*",
    "@adlc/telemetry": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@adlc/adapters": "workspace:*",
    "@adlc/attestation": "workspace:*",
    "@adlc/control-plane": "workspace:*",
    "@adlc/db": "workspace:*",
    "@adlc/domain": "workspace:*",
    "@adlc/gateway": "workspace:*",
    "@adlc/mcp-servers": "workspace:*",
    "@adlc/pack-sdk": "workspace:*",
    "@adlc/schemas": "workspace:*",
    "@adlc/signer": "workspace:*",
    "@adlc/testing": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@types/dockerode": "3.3.42",
    "dockerode": "4.0.12",
    "esbuild": "0.28.1",
    "reflect-metadata": "0.2.2"
  }
}
