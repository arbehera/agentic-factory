{
  "name": "@adlc/notifier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@adlc/db": "workspace:*",
    "@adlc/domain": "workspace:*",
    "@adlc/pack-sdk": "workspace:*",
    "@adlc/schemas": "workspace:*",
    "@adlc/telemetry": "workspace:*",
    "nodemailer": "10.1.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@adlc/control-plane": "workspace:*",
    "@adlc/executor": "workspace:*",
    "@adlc/orchestrator": "workspace:*",
    "@adlc/testing": "workspace:*",
    "@types/node": "22.18.12",
    "@types/nodemailer": "6.4.17",
    "@types/smtp-server": "3.5.10",
    "smtp-server": "3.18.3"
  }
}
