{
  "name": "@adlc/importer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "import:tasks": "tsx src/cli.ts"
  },
  "dependencies": {
    "@adlc/domain": "workspace:*",
    "@adlc/schemas": "workspace:*"
  }
}
