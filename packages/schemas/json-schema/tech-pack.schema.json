{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "codingStandard": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9./_-]+$"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "digest"
      ],
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+$"
        },
        "analysis": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+$"
        },
        "testTarget": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+$"
        },
        "release": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+$"
        }
      },
      "required": [
        "build",
        "analysis",
        "testTarget",
        "release"
      ],
      "additionalProperties": false
    },
    "budgetSchema": {
      "type": "object",
      "properties": {
        "fields": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "automated": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "unit",
              "automated"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    },
    "dodThresholds": {
      "type": "object",
      "properties": {
        "coverage": {
          "type": "object",
          "properties": {
            "statement": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "branch": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "statement",
            "branch"
          ],
          "additionalProperties": false
        },
        "complexity": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "coverage"
      ],
      "additionalProperties": false
    },
    "humanLedCategories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "humanExecutedVerification": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "templateFragments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "evals": {
      "type": "object",
      "properties": {
        "goldenTasks": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+$"
        },
        "canaryCorpus": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+$"
        }
      },
      "required": [
        "goldenTasks",
        "canaryCorpus"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "languages",
    "codingStandard",
    "image",
    "adapters",
    "budgetSchema",
    "dodThresholds",
    "humanLedCategories",
    "humanExecutedVerification",
    "templateFragments",
    "skills",
    "evals"
  ],
  "additionalProperties": false
}
