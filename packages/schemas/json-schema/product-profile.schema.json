{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "adlc.pioneer/v1"
    },
    "kind": {
      "type": "string",
      "const": "ProductProfile"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "owner"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "processPack": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*@\\d+\\.\\d+(\\.\\d+)?$"
        },
        "components": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "pack": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*@\\d+\\.\\d+(\\.\\d+)?$"
              },
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._/-]+\\/$"
                }
              }
            },
            "required": [
              "name",
              "pack",
              "paths"
            ],
            "additionalProperties": false
          }
        },
        "thresholds": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "coverage": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "branch": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              },
              "complexity": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "hardware": {
          "type": "boolean"
        },
        "testTargets": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      },
      "required": [
        "processPack",
        "components",
        "hardware"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
