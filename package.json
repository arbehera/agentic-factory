{
  "name": "adlc-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check:neutrality": "tsx packages/config/src/cli.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm check:neutrality"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.38.0",
    "tsx": "4.20.6",
    "turbo": "2.9.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.6"
  }
}
