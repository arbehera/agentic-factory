# Secrets for the dev Compose stack. `pnpm dev:up` creates infra/compose/.env with random values
# (mode 600, git-ignored). Placeholders only — never put real credentials here (CLAUDE.md §9).
POSTGRES_PASSWORD=change-me
REPLICATION_PASSWORD=change-me
APP_DB_PASSWORD=change-me
FAKES_TOKEN=change-me-at-least-16-chars
INTERNAL_API_TOKEN=change-me-at-least-32-characters-long
KEYCLOAK_ADMIN_PASSWORD=change-me
# Placeholder "API key" the gateway injects into calls to the fake model API (never a real key).
MODEL_API_KEY=change-me
# Password of the placeholder users in the dev realm (infra/compose/keycloak/realm-adlc.json).
ADLC_DEV_USER_PASSWORD=change-me
# SeaweedFS identities for the write-once audit export (ADR-0015).
OBJECT_STORE_ADMIN_SECRET=change-me-at-least-16-chars
OBJECT_STORE_EXPORTER_SECRET=change-me-at-least-16-chars
# Compliance retention of exported audit objects. Dev value; the real period is an ISMS decision.
AUDIT_EXPORT_RETENTION_DAYS=1
