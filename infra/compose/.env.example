# Secrets for the dev Compose stack. `pnpm dev:up` creates infra/compose/.env with random values
# (mode 600, git-ignored). Placeholders only — never put real credentials here (CLAUDE.md §9).
POSTGRES_PASSWORD=change-me
REPLICATION_PASSWORD=change-me
APP_DB_PASSWORD=change-me
FAKES_TOKEN=change-me-at-least-16-chars
INTERNAL_API_TOKEN=change-me-at-least-32-characters-long
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password of the placeholder users in the dev realm (infra/compose/keycloak/realm-adlc.json).
ADLC_DEV_USER_PASSWORD=change-me
